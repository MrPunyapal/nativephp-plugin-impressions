import Foundation
import NativePHP

public enum ImpressionsFunctions {
    public final class {{ function }}: BridgeFunction {
        public init() {}

        public func execute(payload: [String: Any]) async throws -> Any {
            return [
                "plugin": "Impressions",
                "function": "Impressions.{{ function }}",
                "received": payload,
            ]
        }
    }
}
