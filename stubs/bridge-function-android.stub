package com.mrpunyapal.impressions

import com.nativephp.mobile.bridge.BridgeFunction
import org.json.JSONObject

class ImpressionsFunctions {
    class {{ function }} : BridgeFunction() {
        override fun execute(payload: JSONObject): JSONObject {
            val response = JSONObject()

            response.put("plugin", "Impressions")
            response.put("function", "Impressions.{{ function }}")
            response.put("received", payload)

            return response
        }
    }
}
