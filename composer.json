{
    "name": "mrpunyapal/nativephp-plugin-impressions",
    "description": "Native visibility impressions for NativePHP Mobile EDGE components",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "nativephp-mobile",
        "nativephp-plugin",
        "Impressions",
        "nativephp-plugin-impressions"
    ],
    "homepage": "https://github.com/mrpunyapal/nativephp-plugin-impressions",
    "support": {
        "issues": "https://github.com/mrpunyapal/nativephp-plugin-impressions/issues",
        "source": "https://github.com/mrpunyapal/nativephp-plugin-impressions"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nativephp/mobile": "^4.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "MrPunyapal\\Impressions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrPunyapal\\Impressions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrPunyapal\\Impressions\\Providers\\ImpressionsServiceProvider"
            ],
            "aliases": {
                "Impressions": "MrPunyapal\\Impressions\\Facades\\Impressions"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "composer validate --strict && pint --test && phpstan analyse && rector process --dry-run",
        "format": "pint",
        "analyse": "phpstan analyse",
        "rector": "rector process",
        "rector:test": "rector process --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
